{
  "name": "r2-daily-ledger",
  "version": "2.0.0",
  "private": true,
  "description": "钱多多：本地 R2 理财收益账本与 A 股科技产业资料工作台。",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.js",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && node --no-warnings server.js",
    "server": "node --no-warnings server.js",
    "test": "node --test",
    "check": "vue-tsc --noEmit && node --check server.js && node --check lib/db.js && node --check lib/metrics.js && node --check lib/products.js",
    "prod:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-production.ps1",
    "prod:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 -Action start",
    "prod:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 -Action stop",
    "prod:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 -Action restart",
    "prod:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 -Action status"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
